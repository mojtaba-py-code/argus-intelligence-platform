# Copy to .env (git-ignored) and fill in. Never commit real values.
#
# 1) Passwords used by docker-compose only (no ARGUS_ prefix: the application never reads them).
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app
REDIS_PASSWORD=change-me-redis
# Only for the observability stack (deploy/observability/compose.observability.yml):
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# 2) Application key material - generate with:  uv run argus keys generate --quote >> .env
# ARGUS_AUTH__JWT_SIGNING_KEYS=...
# ARGUS_AUTH__JWT_ACTIVE_KID=...
# ARGUS_AUTH__API_KEY_PEPPER=...
# ARGUS_SECURITY__AUDIT_HMAC_KEY=...
# ARGUS_SECURITY__SIGNING_KEY=...
# ARGUS_SECURITY__ENCRYPTION_KEYS=...
# ARGUS_SECURITY__ACTIVE_ENCRYPTION_KEY=...

# 3) Running outside Docker (local PostgreSQL via scripts/local_postgres.py):
# ARGUS_DATABASE__URL=postgresql+asyncpg://argus_app:argus_app_dev_password@127.0.0.1:5432/argus
# ARGUS_DATABASE__MIGRATION_URL=postgresql+asyncpg://argus_owner:argus_owner_dev_password@127.0.0.1:5432/argus

# 4) Optional providers (the platform works offline without them).
# ARGUS_LLM__ANTHROPIC_API_KEY=
# ARGUS_LLM__ANTHROPIC_REFUSAL_FALLBACK=true   # server-side refusal fallback (recommended)
# ARGUS_LLM__OPENAI_API_KEY=                    # OpenAI, or leave empty for a self-hosted server
# ARGUS_LLM__OPENAI_BASE_URL=http://vllm:8000/v1
# ARGUS_LLM__ROUTING_FILE=/etc/argus/llm_routing.yaml   # declare openai/<model> entries here
# ARGUS_EMBEDDINGS__PROVIDER=local          # or voyage (semantic; respects each org's data policy)
# ARGUS_EMBEDDINGS__VOYAGE_API_KEY=
# ARGUS_RETRIEVAL__RERANK=lexical            # or voyage (needs the Voyage key) / none
# ARGUS_SEARCH__PROVIDER=none
# ARGUS_SEARCH__BRAVE_API_KEY=

# 5) Documents. Development scans with a stand-in that only knows the EICAR test file;
#    production requires ClamAV (docker compose --profile scanning).
# ARGUS_DOCUMENTS__SCANNER=clamav
# ARGUS_DOCUMENTS__CLAMAV_HOST=clamav
# Object storage (default: encrypted files under ARGUS_STORAGE__LOCAL_ROOT). For S3/MinIO install
# the s3 extra (uv sync --extra s3) and set:
# ARGUS_STORAGE__BACKEND=s3
# ARGUS_STORAGE__S3_BUCKET=argus-documents
# ARGUS_STORAGE__S3_ENDPOINT_URL=http://minio:9000
# ARGUS_STORAGE__S3_ACCESS_KEY_ID=
# ARGUS_STORAGE__S3_SECRET_ACCESS_KEY=

# 6) Security operations (defaults shown). The scheduler re-verifies every organisation's audit
#    chain; operators verify the platform chain with `argus audit verify` (owner role).
# ARGUS_SECURITY__AUDIT_VERIFY_INTERVAL_H=24
# ARGUS_SECURITY__AUDIT_VERIFY_CHECK_S=900
# ARGUS_SECURITY__AUDIT_VERIFY_BATCH=25
# ARGUS_SECURITY__AUDIT_VERIFICATION_RETENTION_DAYS=90

# 7) Observability. Tracing is off unless enabled; the local stack in
#    deploy/observability/compose.observability.yml sets these for you.
# ARGUS_OBSERVABILITY__OTEL_ENABLED=true
# ARGUS_OBSERVABILITY__OTEL_ENDPOINT=https://otel-collector.internal:4318
# ARGUS_OBSERVABILITY__OTEL_SAMPLE_RATIO=0.1
# ARGUS_OBSERVABILITY__OTEL_HEADERS=authorization=Bearer ...   # collector authentication
# ARGUS_OBSERVABILITY__TRUST_INCOMING_TRACE_CONTEXT=false     # true only behind a gateway
# ARGUS_OBSERVABILITY__METRICS_TOKEN=...                       # required in production
# ARGUS_OBSERVABILITY__METRICS_PORT=9100                       # worker/scheduler /metrics
# ARGUS_OBSERVABILITY__METRICS_HOST=0.0.0.0

# 8) SaaS operation (defaults shown). Self-hosted installations keep "enterprise" (no quotas);
#    a hosted service starts organisations on "free" and changes plans with `argus orgs set-plan`.
# ARGUS_PLATFORM__DEFAULT_PLAN=enterprise
# ARGUS_PLATFORM__DELETION_GRACE_DAYS=30         # a deleted organisation can be restored until then
# ARGUS_PLATFORM__EXPORT_TTL_DAYS=7              # organisation exports are deleted after this
# ARGUS_PLATFORM__LLM_REQUESTS_RETENTION_DAYS=400
# ARGUS_PLATFORM__FINISHED_JOBS_RETENTION_DAYS=30
# ARGUS_HTTP__WEB_DASHBOARD=true                 # the web dashboard at /app

# Any ARGUS_* variable can instead be read from a file: ARGUS_<NAME>_FILE=/run/secrets/<name>.
# A misspelt ARGUS_* variable stops the process at start-up (typo protection).
